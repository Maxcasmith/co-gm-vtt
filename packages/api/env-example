# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT Secret (CHANGE IN PRODUCTION! - for YOUR app's access tokens)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32-chars-minimum

# Token Encryption Key (CHANGE IN PRODUCTION! - MUST be exactly 32 characters for encrypting Google tokens)
TOKEN_ENCRYPTION_KEY=12345678901234567890123456789012

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-from-google-cloud-console
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-google-cloud-console
GOOGLE_REDIRECT_URI=postmessage

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=ai-vtt

DEPLOY_TARGET=saas

# Admin panel password fallback — only used if no admin password is set in-app (Settings)
ADMIN_PASSWORD=admin

# Storage backend — 'local' (default), 's3', or 'rds', set independently per store
STORAGE_TEXT_BACKEND=local
STORAGE_MEDIA_BACKEND=local

# Required only when STORAGE_TEXT_BACKEND/STORAGE_MEDIA_BACKEND=s3
AWS_REGION=us-east-1
S3_TEXT_BUCKET=your-text-bucket-name
S3_MEDIA_BUCKET=your-media-bucket-name
